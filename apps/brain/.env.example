# Project Brain — local configuration. Copy to .env.local and fill in.
# Never commit .env.local.

# At least one free AI key, for "Ask your codebase". Search, architecture and
# impact analysis work without any key.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional. Raises GitHub's rate limit for repository metadata from 60 to
# 5,000 requests an hour. Server-side only; never sent to the browser.
GITHUB_TOKEN=

# Optional. Any OpenAI-compatible endpoint, tried first — e.g. a local model so
# code never leaves this machine:
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
BRAIN_OPENAI_BASE_URL=
BRAIN_OPENAI_MODEL=
BRAIN_OPENAI_API_KEY=
BRAIN_OPENAI_CONTEXT=32768

# The free trial on this site's own key: how many questions each visitor gets per
# day before adding their own key, and a cap across everyone so the key is not drained.
BRAIN_TRIAL_QUESTIONS=2
BRAIN_TRIAL_DAILY_CAP=200
# Any random string; used to hash visitor addresses for the trial count.
BRAIN_TRIAL_SALT=

# The password for /admin. Leave empty and the page only says so.
ADMIN_PASSWORD=

# Optional. Any Upstash-compatible Redis REST endpoint (Vercel KV is one), so
# the anonymous counts from the extension survive a deployment. Without it they
# are held in memory and reset whenever the server restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
