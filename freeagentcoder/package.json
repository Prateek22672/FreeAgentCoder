{
  "name": "freeagentcoder",
  "displayName": "FreeAgentCoder",
  "description": "Autonomous AI coding agent that runs on free models. Plans, edits, runs and verifies code, and switches between your API keys when one hits its limit.",
  "version": "0.1.0",
  "publisher": "PrateekKoratala",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prateek22672/FreeAgentCoder",
    "directory": "freeagentcoder"
  },
  "bugs": {
    "url": "https://github.com/Prateek22672/FreeAgentCoder/issues"
  },
  "homepage": "https://github.com/Prateek22672/FreeAgentCoder/tree/main/freeagentcoder#readme",
  "galleryBanner": {
    "color": "#0c0c0d",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "ai",
    "agent",
    "coding agent",
    "autonomous",
    "free",
    "llm",
    "gemini",
    "groq",
    "cerebras",
    "mistral",
    "openrouter",
    "code generation",
    "refactor",
    "debug",
    "python",
    "machine learning",
    "api keys"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "freeagentcoder.open",
        "title": "Open Chat",
        "category": "FreeAgentCoder"
      },
      {
        "command": "freeagentcoder.newChat",
        "title": "New Chat",
        "category": "FreeAgentCoder"
      },
      {
        "command": "freeagentcoder.manageKeys",
        "title": "Manage API Keys",
        "category": "FreeAgentCoder"
      },
      {
        "command": "freeagentcoder.showUsage",
        "title": "Show Usage",
        "category": "FreeAgentCoder"
      },
      {
        "command": "freeagentcoder.stop",
        "title": "Stop Current Task",
        "category": "FreeAgentCoder"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "freeagentcoder",
          "title": "FreeAgentCoder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "freeagentcoder": [
        {
          "type": "webview",
          "id": "freeagentcoder.chat",
          "name": "FreeAgentCoder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "npx --yes @vscode/vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview/app",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@agentic/core": "file:../packages/core",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.1"
  }
}
